# Bulk CTI source data - re-downloadable via src/corpus/real_cti_loader.py (see data/README.md)
data/raw/
data/processed/

# Embedding cache (vectors.npy, ~55 MB) - rebuilt automatically on the first run
data/cache/

# Benchmark outputs - regenerated by scripts/run_*.py.
# The runs behind the article (v2, v2_rerun, v3) and their logs ARE tracked, so every figure
# can be checked without re-running the benchmark. The two large per-run files are tracked
# only in compressed form (*.json.xz); unpack them with `xz -dk` before auditing.
outputs/*
!outputs/logs/
!outputs/reports/
outputs/reports/*
!outputs/reports/v2/
!outputs/reports/v2_rerun/
!outputs/reports/v3/
outputs/reports/*/comparison_benchmark_results.json
outputs/reports/*/generation_traces.json

# Archived artefacts derived from outputs/ - same rule as above, just moved.
# The rest of archive/ (kod, rusztowanie agentow) jest sledzone celowo.
archive/outputs_v1/
archive/pre_audit_backup/

# Secrets
.env
*.key

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
